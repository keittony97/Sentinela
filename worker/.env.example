SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
POLL_INTERVAL_SECONDS=3

# Opcionais — cada ferramenta que depende delas cai para um achado
# informativo (não falha o scan) quando a variável não está configurada.
HIBP_API_KEY=
WPSCAN_API_TOKEN=
GVM_USERNAME=
GVM_PASSWORD=
GVM_HOSTNAME=
GVM_PORT=9390
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
GVM_SCANNER_ID=
CONTAINER_SCAN_IMAGE_REF=
